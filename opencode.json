{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git restore *": "deny",
      "* git restore *": "deny",
      "git * restore *": "deny",
      "* git * restore *": "deny",
      "git checkout -- *": "deny",
      "* git checkout -- *": "deny",
      "git checkout .": "deny",
      "* git checkout . *": "deny",
      "git reset --hard*": "deny",
      "* git reset --hard*": "deny",
      "git clean -*f*": "deny",
      "* git clean -*f*": "deny"
    }
  }
}
